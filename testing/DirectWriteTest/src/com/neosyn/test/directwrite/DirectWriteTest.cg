/*
 * Test network with external ports and internal cross-task communication.
 * External testbench drives input_val, checks output_val.
 * Internally, tester forwards to processor and processor doubles and sends back.
 */
package test;

network DirectWriteTest {
    properties {
        test: {
            input_val: [ 5, 10, 0, 127, 1 ],
            output_val: [ 10, 20, 0, 254, 2 ]
        }
    }

    in stream u8 input_val;
    out stream u8 output_val;

    // processor: receives input, doubles it, sends output
    processor = new task {
        in push u8 proc_in;
        out push u8 proc_out;

        void loop() {
            u8 val = proc_in.read();
            proc_out.write(val * 2);
        }
    };

    // tester: forwards network input to processor, forwards result to network output
    tester = new task {
        void loop() {
            // Read from network input, write to processor
            processor.proc_in.write(input_val.read());
            fence;

            // Read from processor, write to network output
            output_val.write(processor.proc_out.read());
        }
    };
}
