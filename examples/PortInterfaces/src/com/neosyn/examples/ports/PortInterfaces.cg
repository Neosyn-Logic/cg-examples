package com.neosyn.examples.ports;

/*
 * PortInterfaces — the three port kinds, side by side.
 *
 * Every port chooses how producer and consumer synchronize. C⏚ has two
 * synchronizing interfaces plus a bare (unsynchronized) one:
 *
 *   bare      no handshake. The value is just a wire, valid every cycle.
 *   push      valid only. The producer writes; the consumer must be ready
 *             to catch it. Fire-and-forget. (Replaces the old `sync`.)
 *   stream    valid + ready. The consumer can stall the producer with
 *             backpressure. (Replaces the old `sync ready`.)
 *
 * There is no `confirm` (valid + ack) any more: since 3.5.1 it is refused
 * with an error, because the generated hardware never read the ack, so a
 * value the consumer was not ready for was lost. Use `stream` when the
 * producer must not lose a value, `push` when it may.
 *
 * This network wires one of each into a single processor that sums the
 * three values, proving all three kinds interoperate. A checker reads
 * the result and asserts it.
 *
 * Run it: open in VS Code (Neosyn C⏚ extension) and use "Fast Sim".
 */
network PortInterfaces {
    properties { test: { terminate: "checker.finished" } }

    // DRIVER — one output per interface kind.
    driver = new task {
        out push    u8 a;   // fire-and-forget
        out stream  u8 b;   // backpressured
        out         u8 c;   // bare: a wire, holds its last value

        void setup() {
            a.write(10);
            b.write(20);
            c.write(30);
        }
    };

    // PROCESSOR — read one of each and combine them.
    processor = new task {
        in push    u8 inA;
        in stream  u8 inB;
        in          u8 inC;
        out push    u10 result;

        void setup() {
            u10 sum = inA.read() + inB.read() + inC.read();   // 3 x u8: up to 765
            result.write(sum);
        }
    };
    // Positional wiring: fills processor's inputs in declaration order,
    // so inA <- a, inB <- b, inC <- c.
    processor.reads(driver.a, driver.b, driver.c);

    // CHECKER — verify the combined result.
    checker = new task {
        bool finished;

        void setup() {
            finished = false;
        }

        void loop() {
            if (!finished) {
                u10 r = processor.result.read();
                assert(r == 60);          // 10 + 20 + 30
                print("push+stream+bare sum = ", r, " OK\n");
                finished = true;
            }
        }
    };
}
